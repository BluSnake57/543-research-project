# Copy to .env; Docker Compose reads it automatically.
# Compose builds separate local-cuda and local-cpu images; no registry image is used.
# Use the server's private/LAN IP (or 0.0.0.0) for access from other machines.
# Use 127.0.0.1 only for access through a proxy running directly on this host.
NOVNC_BIND_ADDRESS=0.0.0.0
NOVNC_PORT=36080
DESKTOP_SIZE=1600x900

# CPU cores worth of time; fractional values work. 0 removes the CPU quota.
CONTAINER_CPUS=8
# Hard RAM limit. 0 removes the RAM limit; e.g. 32g allows larger models.
CONTAINER_MEMORY=16g
# Defaults for BLAS/OpenMP/PyTorch CPU work; this is not a hard process limit.
COMPUTE_THREADS=4
CONTAINER_SHM_SIZE=1gb
CONTAINER_TMP_SIZE=1g
CONTAINER_PIDS=512
